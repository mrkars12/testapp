  easykash
  upay
  fabmisr
}

/// وسيلة الدفع زي ما العميل بيشوفها.
///
/// مختلفة عن PaymentProviderKey: البوابة الواحدة بتقدّم أكتر من وسيلة،
/// والوسيلة الواحدة بتتقدّم من أكتر من بوابة.
