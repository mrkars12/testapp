/// وضع الدفع للمتجر. واحد بس نشط في أي وقت.
///
/// MERCHANT_GATEWAY: التاجر بيوصّل حساب بوابته الخاص (Stripe, Paymob,
///   Moyasar…). البوابات دي مزوّدين تحت الوضع ده، مش أوضاع منفصلة.
///
/// MERCHANT_MOR: النموذج المُدار. **مش متنفّذ في المرحلة دي** — القيمة
///   موجودة عشان الدفعات القديمة تفضل معروفة الوضع بعد أي تحويل، ومفيش
///   أي منطق دفع أو قيود دفتر مبنية عليها لسه.
enum StorePaymentMode {
  MERCHANT_GATEWAY
  MERCHANT_MOR
}

enum RefundStatus {
  pending
  succeeded
  failed
  cancelled
}

/// مين بدأ الاسترداد
enum RefundInitiator {
  merchant
  customer
  provider
  system
}

enum OwnershipModel {
  /// التاجر بيدخل مفاتيح البوابة بنفسه
  merchant_credentials
  /// حساب متصل تديره المنصة — المرحلة 6
  platform_managed
}

enum PaymentAccountStatus {
  /// اتعمل بس لسه مافيش بيانات اعتماد
  draft
  /// بيانات الاعتماد موجودة والتحقق منها لسه ماتمش
  verifying
  active
  disabled
  /// آخر تحقق فشل — التفاصيل في last_error
  errored
}

/// نوع الالتزام اللي وسيلة الدفع بتنتجه لما العميل يأكّد الطلب
enum CommitmentKind {
  /// تفويض أو تحصيل نجح فعلاً (Stripe / Paymob / Moyasar / Tap)
  funds_secured
  /// وعد غير ممول والتاجر بيقبله (الدفع عند الاستلام / تحويل بنكي)
  promise_accepted
  /// صدر رقم مرجعي والعميل هيدفع بعدين (فوري / كشك)
  awaiting_offline_settlement
}

enum CaptureMode {
  automatic
  manual
}

/// وسائل الدفع اللي العميل بيشوفها عند الدفع.
///
/// صف لكل (حساب × وسيلة × إعداد البوابة). ده اللي بيحل مشكلة البوابات
/// اللي بتقدّم أكتر من تكامل تحت نفس الحساب — زي Paymob اللي بيديك
/// integration_id مختلف للكارت والمحفظة والكشك، والتاجر عايز يعرضهم
/// كأزرار منفصلة في صفحة الدفع.
model PaymentMethodOffering {
  id BigInt @id @default(autoincrement())

  account_id BigInt
  account    PaymentAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)

  /// نفس مالك الحساب — متكرر عشان الاستعلامات تتقيّد من غير join
  store_id BigInt
  mode     Mode

  method PaymentMethodKey

  /// معرّف التكامل عند البوابة (مثال: integration_id في Paymob).
  /// نص فاضي معناه إن البوابة مالهاش تكاملات متعددة.
  gateway_method_config String @default("") @db.VarChar(255)

  enabled  Boolean @default(false)
  position Int     @default(0)

  /// الاسم اللي بيظهر للعميل. null معناه استخدم الاسم الافتراضي للوسيلة.
  display_name_ar String? @db.VarChar(120)
  display_name_en String? @db.VarChar(120)

  /// قيود اختيارية: أقل/أكبر مبلغ، عملات مسموحة، مدن مسموحة.
  /// المبالغ بالوحدات الصغرى زي أي مبلغ في المشروع.
  constraints Json?

  /// نوع الالتزام اللي الوسيلة دي بتنتجه — ده اللي بيخلي الدفع عند
  /// الاستلام وفوري و Stripe يمرّوا بنفس المسار في المرحلة 1b.2.
  commitment_kind CommitmentKind @default(funds_secured)

  capture_mode CaptureMode @default(automatic)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@unique([account_id, method, gateway_method_config])
  @@index([store_id, mode])
  @@index([account_id])
  @@index([store_id, mode, enabled, position])
  @@map("payment_method_offerings")
}

/// اتصال متجر ببوابة دفع.
///
/// المتجر ممكن يكون عنده أكتر من حساب لنفس البوابة (عملات مختلفة،
/// كيانات مختلفة، أو ترحيل من حساب لحساب)، وعشان كده الاسم المعروض
/// جزء من مفتاح التفرّد.
///
/// ⚠️ المفتاح الأساسي لازم يفضل BigInt مربوط بـ sequence: بيانات
/// الاعتماد مشفّرة بـ AAD مربوط بـ id الصف، والـ id لازم يبقى معروف
/// قبل التشفير (شوف IdReservationService).
model PaymentAccount {
  id BigInt @id @default(autoincrement())

  store_id BigInt
  store    store  @relation(fields: [store_id], references: [id], onDelete: Cascade)

  /// عزل كامل بين بيانات الاختبار والبيانات الحقيقية
  mode Mode

  gateway PaymentProviderKey

  /// اسم من اختيار التاجر يفرّق بين حسابات نفس البوابة
  display_name String @db.VarChar(120)

  /// merchant_credentials = التاجر بيدخل مفاتيحه بنفسه (الوضع الحالي)
  /// platform_managed     = حساب متصل تديره المنصة (المرحلة 6)
  ownership_model OwnershipModel @default(merchant_credentials)

  /// معرّف الحساب المتصل عند البوابة — null في وضع مفاتيح التاجر
  connected_account_ref String? @db.VarChar(255)

  /// ═══ بيانات الاعتماد ═══
  ///
  /// مشفّرة بمفتاح مشتق للمتجر (StoreKeyService)، والـ AAD مربوط بـ:
  ///     (store_id, mode, 'payment_account', id, 'credentials')
  ///
  /// ⚠️ **مابترجعش أبداً في أي رد API.** الواجهة بتاخد تلميح مقنّع
  /// (credentials_hint) و is_configured بس.
  credentials_envelope String?
  credential_kek_version Int?
  credential_dek_version Int?

  /// HMAC بمفتاح المتجر — للكشف عن التغيير ولعرض تلميح مقنّع،
  /// مش hash عادي للسر عشان مايبقاش قابل للتخمين
  credentials_fingerprint String? @db.VarChar(64)

  /// آخر 4 حروف من كل حقل، للعرض بس. مفيش أسرار كاملة هنا.
  credentials_hint Json?

  /// العملة اللي البوابة بتسوّي بيها على الحساب ده
  settlement_currency String? @db.VarChar(3)

  status PaymentAccountStatus @default(draft)

  /// نتيجة آخر تحقق من بيانات الاعتماد — بيتملّى في المرحلة 1b.2
  /// لما أول أدابتر يقدر يكلّم البوابة فعلاً
  last_verified_at DateTime? @db.Timestamptz(6)
  last_error       String?

  offerings PaymentMethodOffering[]

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@unique([store_id, mode, gateway, display_name])
  @@index([store_id, mode])
  @@index([store_id, mode, status])
  @@map("payment_accounts")
}


// ═══════════════════════════════════════════════════════════════════
// Phase 1a — Foundations
//
// إضافات فقط. مفيش أي جدول موجود في قاعدة البيانات بيتغيّر.
//
// الموديلات المؤقتة اللي كانت مكتوبة هنا لجداول دفع **مش موجودة**
// في قاعدة البيانات اتشالت من الملف ده، لأن وجودها كان بيخلي هجرة
// المرحلة 1a تحاول تنشئ جداول مش من نطاقها. اتحفظت كاملة في:
//
//     prisma/phase1b-placeholders.prisma.bak
//
// وهترجع بشكلها النهائي في المرحلة 1b.
//
// PaymentProviderKey اتساب زي ما هو — الـ enum موجود في قاعدة البيانات
// وبيستخدمه PaymentAccount.
//
// ملاحظة على التقسيم (partitioning): الجداول دي مش مقسّمة في 1a لأنها
// هتفضل فاضية في الإنتاج (مفيش producer). التقسيم بيتعمل في 1b مع أول
// producer، وقتها التحويل drop-and-recreate على جدول فاضي.
// ═══════════════════════════════════════════════════════════════════

/// وضع التشغيل — العزل الكامل بين بيانات الاختبار والبيانات الحقيقية.
/// في المرحلة 1a بيتبعت كمعامل صريح؛ الحل التلقائي بييجي في 1b.
enum Mode {
  test
  live
}

enum OutboxStatus {
  pending
  claimed
  published
  failed
  dead
}

enum IdempotencyStatus {
  in_flight
  completed
  failed
}

/// سجل الطلبات المتكرّرة (Idempotency).
///
/// مفيش FK على store عن قصد: السجل لازم يفضل موجود حتى لو المتجر
/// اتحذف، عشان التدقيق. store_id هنا قيمة نطاق مش اعتماد مرجعي.
model PaymentIdempotencyRecord {
  id BigInt @id @default(autoincrement())

  store_id BigInt
  mode     Mode

  /// اسم العملية المنطقي، مثال: "payments.create_intent"
  scope String @db.VarChar(100)

  /// المفتاح اللي بعته العميل في هيدر Idempotency-Key
  idempotency_key String @db.VarChar(255)

  /// hash للـ method + path + body بعد التطبيع — عشان نكشف
  /// نفس المفتاح مع body مختلف
  request_fingerprint String @db.VarChar(64)

  status IdempotencyStatus @default(in_flight)

  response_status_code Int?
  /// الرد المخزّن للإعادة. بيمرّ على redaction قبل التخزين.
  response_body        Json?

  /// حجز للطلب الجاري — الطلب المكرر المتزامن بيستنى أو يترفض
  locked_until DateTime? @db.Timestamptz(6)

  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  expires_at   DateTime  @db.Timestamptz(6)

  @@unique([store_id, mode, scope, idempotency_key])
  @@index([expires_at])
  @@index([store_id, mode])
  @@map("payment_idempotency_records")
}

/// صندوق الصادر (Transactional Outbox).
///
/// الرسالة بتتكتب جوه نفس الـ transaction بتاعة تغيير الحالة، فمفيش
/// احتمال إن الحالة تتحفظ والحدث يضيع أو العكس.
///
/// مفيش FK على store: الحذف المتتالي ماينفعش يمسح أحداث لسه ماتسلّمتش.
model OutboxMessage {
  id BigInt @id @default(autoincrement())

  store_id BigInt
  mode     Mode

  /// نوع الكيان المصدر، مثال: "checkout"
  aggregate_type String @db.VarChar(64)
  aggregate_id   String @db.VarChar(64)

  /// نوع الحدث، مثال: "checkout.committed"
  event_type    String @db.VarChar(100)
  /// إصدار عقد الحدث — موجود من الرسالة رقم 1، مش من رقم 100000
  event_version Int    @default(1)

  payload Json

  status OutboxStatus @default(pending)

  /// حجز للتوزيع — بيخلي أكتر من instance تشتغل بأمان من غير Redis
  claimed_by        String?   @db.VarChar(100)
  claim_expires_at  DateTime? @db.Timestamptz(6)

  attempts        Int       @default(0)
  next_attempt_at DateTime  @default(now()) @db.Timestamptz(6)
  last_error      String?

  /// وقت حدوث الحدث في العمل (مقابل وقت تسجيله في النظام)
  occurred_at  DateTime  @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  published_at DateTime? @db.Timestamptz(6)

  consumptions ConsumedEvent[]

  @@index([status, next_attempt_at])
  @@index([aggregate_type, aggregate_id])
  @@index([store_id, mode])
  @@index([created_at])
  @@map("outbox_messages")
}

/// سجل استهلاك الأحداث لكل مستهلك.
///
/// القيد الفريد ده **هو** ضمانة الـ at-least-once، مش فحص في الكود.
model ConsumedEvent {
  id BigInt @id @default(autoincrement())

  consumer_name String @db.VarChar(100)
  message_id    BigInt

  store_id BigInt
  mode     Mode

  consumed_at DateTime @default(now()) @db.Timestamptz(6)
  /// نتيجة مختصرة للتشخيص، مثال: "ok" أو "skipped:duplicate"
  result      String?  @db.VarChar(255)

  message OutboxMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@unique([consumer_name, message_id])
  @@index([message_id])
  @@index([store_id, mode])
  @@map("consumed_events")
}

// ═══════════════════════════════════════════════════════════════════
// المرحلة 1b.2 — Checkout والنوايا والدفتر
//
// المبادئ اللي الجداول دي مبنية عليها:
//   • المبالغ أعداد صحيحة بالوحدات الصغرى (amount_minor) + عملة.
//   • الطلب بيتولد من **التزام** الـ checkout، مش قبله.
//   • الحالة بتتحرس بجدول انتقالات في الكود، مابتتكتبش فوقها.
//   • كل حركة مالية قيد غير قابل للتعديل في الدفتر؛ الأرصدة تُشتق.
//   • مفيش FK على store لأي سجل مالي: حذف المتجر ماينفعش يمسح
//     سجلات مالية. الـ FK موجود بس على الكيانات المؤقتة (Checkout).
// ═══════════════════════════════════════════════════════════════════

enum CheckoutStatus {
  open
  pending_payment
  committed
  expired
  abandoned
  failed
}

enum QuoteComponentKind {
  line_subtotal
  shipping
  tax
  discount
  payment_fee
  adjustment
}

enum ReservationState {
  held
  converted
  released
  expired
}

enum PaymentIntentContextKind {
  checkout
  order_balance
  subscription_cycle
  invoice
  manual
}

enum PaymentIntentUsage {
  one_time
  setup
  recurring
}

enum PaymentIntentStatus {
  created
  requires_payment_method
  requires_action
  processing
  authorized
  partially_captured
  captured
  partially_refunded
  refunded
  failed
  cancelled
  expired
}

enum PaymentAttemptStatus {
  initialized
  requires_action
  processing
  authorized
  succeeded
  failed
  expired
  cancelled
}

/// الخطوة اللي العميل لازم يعملها عشان الدفع يكمل.
/// reference_code و bank_instructions هما اللي بيخلّوا فوري والتحويل
/// البنكي يمرّوا بنفس المسار بتاع البوابات الأونلاين.
enum NextActionKind {
  none
  redirect
  iframe
  client_sdk
  reference_code
  bank_instructions
  poll
}

enum CaptureStatus {
  pending
  succeeded
  failed
}

enum AllocationKind {
  revenue
  platform_fee
  vendor_share
}

enum BeneficiaryKind {
  store
  vendor
  platform
}

enum LedgerAccountType {
  psp_receivable
  offline_receivable
  cash_collected
  settled_out
  sales_revenue
  refunds_contra
  psp_fee_expense
  platform_fee_expense
  platform_fee_payable
  disputes_held
  chargeback_loss
  fx_conversion
  suspense
}

enum PostingDirection {
  debit
  credit
}

enum PaymentEventSource {
  api
  webhook
  reconciliation
  return_url
  merchant
  system
}

/// سلة مجمّدة + عنوان + سعر، قبل ما تتحوّل لطلب.
///
/// الـ checkout بياخد token معتّم مش رقم تسلسلي: أرقام الطلبات
/// بتتحجز عند الالتزام بس، فالسلة المهجورة مابتستهلكش رقم.
model Checkout {
  id BigInt @id @default(autoincrement())

  store_id BigInt
  store    store  @relation(fields: [store_id], references: [id], onDelete: Cascade)
  mode     Mode

  /// المعرّف العلني اللي بيظهر في رابط صفحة الدفع
  token String @unique @db.VarChar(64)

  status CheckoutStatus @default(open)

  customer_name  String? @db.VarChar(160)
  customer_email String? @db.VarChar(160)
  customer_phone String? @db.VarChar(40)

  shipping_address Json?

  /// عملة العرض، مجمّدة وقت الإنشاء
  currency String @db.VarChar(3)

  /// مجموع كل مكوّنات السعر، بالوحدات الصغرى
  quote_total_minor BigInt @default(0)

  /// ختم على السلة والسعر — بيمنع تعديل السلة أثناء الدفع
  quote_hash String? @db.VarChar(64)

  /// وسيلة الدفع اللي العميل اختارها
  selected_offering_id BigInt?

  expires_at   DateTime  @db.Timestamptz(6)
  committed_at DateTime? @db.Timestamptz(6)

  /// الطلب اللي اتولد من الالتزام
  order_id BigInt? @unique

  client_ip  String? @db.VarChar(64)
  user_agent String? @db.VarChar(400)

  items        CheckoutLineItem[]
  components   QuoteComponent[]
  reservations InventoryReservation[]

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([store_id, mode, status])
  @@index([expires_at])
  @@index([store_id, mode, created_at])
  @@map("checkouts")
}

/// لقطة من المنتج وقت الإضافة للسلة.
/// المراجع nullable عن قصد: الطلب لازم يفضل مقروء حتى لو المنتج اتحذف.
model CheckoutLineItem {
  id BigInt @id @default(autoincrement())

  checkout_id BigInt
  checkout    Checkout @relation(fields: [checkout_id], references: [id], onDelete: Cascade)

  product_id BigInt?
  variant_id BigInt?

  title         String  @db.VarChar(255)
  variant_title String? @db.VarChar(255)
  image_url     String? @db.VarChar(600)

  unit_price_minor BigInt
  quantity         Int

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([checkout_id])
  @@map("checkout_line_items")
}

/// مكوّن من مكوّنات السعر.
///
/// الشحن والضرايب والخصومات بتتحسب في وحدات منفصلة وبتضيف صفوف هنا،
/// فـ Checkout مش محتاج يعرف حاجة عنهم.
/// ثابت: quote_total_minor = مجموع amount_minor لكل المكوّنات.
model QuoteComponent {
  id BigInt @id @default(autoincrement())

  checkout_id BigInt
  checkout    Checkout @relation(fields: [checkout_id], references: [id], onDelete: Cascade)

  kind  QuoteComponentKind
  label String             @db.VarChar(160)

  /// ممكن يكون سالب (خصم)
  amount_minor BigInt

  /// الوحدة اللي حسبت المكوّن ده
  source_ref String? @db.VarChar(120)

  position Int @default(0)

  @@index([checkout_id])
  @@map("quote_components")
}

/// حجز مخزون مؤقت أثناء الدفع.
///
/// بيتحوّل لسطر طلب عند الالتزام، وبيترجع عند الانتهاء أو الفشل.
model InventoryReservation {
  id BigInt @id @default(autoincrement())

  checkout_id BigInt
  checkout    Checkout @relation(fields: [checkout_id], references: [id], onDelete: Cascade)

  store_id   BigInt
  mode       Mode
  variant_id BigInt
  quantity   Int

  state ReservationState @default(held)

  expires_at DateTime  @db.Timestamptz(6)
  settled_at DateTime? @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([checkout_id, variant_id])
  @@index([state, expires_at])
  @@index([store_id, mode, variant_id])
  @@map("inventory_reservations")
}

/// جذر عملية الدفع.
///
/// بيفضل موجود عبر المحاولات الفاشلة: العميل اللي بطاقته اترفضت وجرّب
/// تانية بيبقى عنده نية واحدة ومحاولتين، مش عمليتين منفصلتين.
///
/// context_kind بيفك الارتباط بالـ checkout عشان الاشتراكات والفواتير
/// في المراحل الجاية تقدر تعمل نوايا من غير سلة.
model PaymentIntent {
  id BigInt @id @default(autoincrement())

  store_id BigInt
  mode     Mode

  context_kind PaymentIntentContextKind @default(checkout)
  context_id   String                   @db.VarChar(64)

  amount_minor BigInt
  currency     String @db.VarChar(3)

  capture_method CaptureMode        @default(automatic)
  usage          PaymentIntentUsage @default(one_time)

  /// وضع الدفع وقت إنشاء النية.
  ///
  /// ⚠️ لقطة مقصودة. الاسترداد لازم يتربط بالمسار اللي عالج الدفعة
  /// أصلاً، مش بالوضع النشط على المتجر وقت طلب الاسترداد. من غير
  /// العمود ده، تحويل المتجر لوضع تاني بيخلي الاستردادات القديمة
  /// تتحسب غلط بأثر رجعي.
  payment_mode StorePaymentMode @default(MERCHANT_GATEWAY)

  status PaymentIntentStatus @default(created)

  /// نسخ مخزّنة من حقيقة الدفتر — بيتأكد منها فاحص الثوابت
  authorized_total_minor BigInt @default(0)
  captured_total_minor   BigInt @default(0)
  refunded_total_minor   BigInt @default(0)

  /// تحكّم تفاؤلي في التزامن
  version Int @default(0)

  /// مفتاح العميل — فريد لكل متجر ووضع
  idempotency_key String? @db.VarChar(255)

  account_id  BigInt?
  offering_id BigInt?

  expires_at  DateTime? @db.Timestamptz(6)
  terminal_at DateTime? @db.Timestamptz(6)

  metadata Json?

  attempts PaymentAttempt[]
  captures Capture[]
  refunds  Refund[]
  events   PaymentEvent[]

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@unique([store_id, mode, idempotency_key])
  @@index([store_id, mode, status])
  @@index([context_kind, context_id])
  @@index([status, expires_at])
  @@index([store_id, mode, created_at])
  @@map("payment_intents")
}

/// محاولة واحدة على حساب بوابة واحد.
///
/// بتحمل حقائق التفويض بنفسها — مفيش كيان Authorization منفصل، لأن
/// مفيش بوابة بتدي أكتر من تفويض للمحاولة الواحدة.
model PaymentAttempt {
  id BigInt @id @default(autoincrement())

  intent_id BigInt
  intent    PaymentIntent @relation(fields: [intent_id], references: [id], onDelete: Cascade)

  store_id BigInt
  mode     Mode

  /// ترتيب المحاولة داخل النية
  sequence Int

  account_id  BigInt?
  offering_id BigInt?

  status PaymentAttemptStatus @default(initialized)

  authorized_amount_minor   BigInt?
  authorization_expires_at  DateTime? @db.Timestamptz(6)

  /// معرّفات البوابة — التفرّد على مستوى الحساب مش البوابة، عشان
  /// متجرين بنفس حساب البوابة مايتعارضوش
  gateway_reference  String? @db.VarChar(255)
  gateway_payment_id String? @db.VarChar(255)

  next_action_kind       NextActionKind @default(none)
  next_action_payload    Json?
  next_action_expires_at DateTime?      @db.Timestamptz(6)

  /// مشتق من (store, intent, sequence, operation) — مش عشوائي، عشان
  /// إعادة المحاولة تبعت نفس المفتاح للبوابة
  psp_idempotency_key String? @db.VarChar(255)

  /// من تصنيف الأخطاء الموحّد، مش نص البوابة الخام
  error_code        String? @db.VarChar(60)
  error_message_raw String?

  request_snapshot  Json?
  response_snapshot Json?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@unique([intent_id, sequence])
  @@unique([account_id, gateway_reference])
  @@index([store_id, mode, status])
  @@index([gateway_reference])
  @@map("payment_attempts")
}

/// تحصيل فعلي لمبلغ.
/// أكتر من تحصيل للمحاولة الواحدة مسموح (شحن على دفعات).
model Capture {
  id BigInt @id @default(autoincrement())

  intent_id  BigInt
  intent     PaymentIntent @relation(fields: [intent_id], references: [id], onDelete: Cascade)
  attempt_id BigInt?

  store_id BigInt
  mode     Mode

  amount_minor BigInt
  currency     String @db.VarChar(3)

  status CaptureStatus @default(pending)

  gateway_capture_ref String? @db.VarChar(255)

  captured_at DateTime? @db.Timestamptz(6)

  allocations CaptureAllocation[]
  refunds     Refund[]

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([intent_id, status])
  @@index([store_id, mode, status])
  @@map("captures")
}

/// توزيع التحصيل على المستفيدين.
///
/// في المرحلة دي صف واحد بس للمتجر نفسه (+ عمولة منصة اختيارية)،
/// لكن البُعد موجود من دلوقتي عشان السوق متعدد البائعين مايبقاش
/// إعادة كتابة للدفتر بعدين.
/// ثابت: مجموع amount_minor = amount_minor بتاع التحصيل.
model CaptureAllocation {
  id BigInt @id @default(autoincrement())

  capture_id BigInt
  capture    Capture @relation(fields: [capture_id], references: [id], onDelete: Cascade)

  beneficiary_id BigInt
  store_id       BigInt
  mode           Mode

  amount_minor BigInt
  kind         AllocationKind @default(revenue)

  @@index([capture_id])
  @@index([beneficiary_id])
  @@map("capture_allocations")
}

/// استرداد مبلغ محصّل.
///
/// مربوط بالتحصيل اللي جه منه، مش بالطلب: التحصيل هو اللي بيعرف أي
/// حساب بوابة استلم الفلوس فعلاً، والاسترداد لازم يرجع من نفس المسار.
model Refund {
  id BigInt @id @default(autoincrement())

  intent_id BigInt
  intent    PaymentIntent @relation(fields: [intent_id], references: [id], onDelete: Cascade)

  /// null للاستردادات اللي البوابة بلّغت عنها من غير ما تحدّد التحصيل
  capture_id BigInt?
  capture    Capture? @relation(fields: [capture_id], references: [id], onDelete: SetNull)

  store_id BigInt
  mode     Mode

  amount_minor BigInt
  currency     String @db.VarChar(3)

  status    RefundStatus    @default(pending)
  initiated_by RefundInitiator @default(merchant)

  reason String? @db.VarChar(400)

  gateway_refund_ref String? @db.VarChar(255)

  /// مفتاح العميل — فريد لكل متجر ووضع
  idempotency_key String? @db.VarChar(255)

  failure_code String? @db.VarChar(60)

  allocations RefundAllocation[]

  succeeded_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([store_id, mode, idempotency_key])
  @@unique([store_id, gateway_refund_ref])
  @@index([intent_id, status])
  @@index([store_id, mode, created_at])
  @@map("refunds")
}

/// توزيع الاسترداد على المستفيدين.
///
/// بيعكس CaptureAllocation بالظبط. تحت MERCHANT_GATEWAY بيبقى صف واحد،
/// لكن البُعد لازم يكون موجود من دلوقتي: استرداد 40 من تحصيل 100 كان
/// متقسّم 90/10 لازم يسحب 36/4، مش 40 من جهة واحدة.
/// ثابت: مجموع amount_minor = amount_minor بتاع الاسترداد.
model RefundAllocation {
  id BigInt @id @default(autoincrement())

  refund_id BigInt
  refund    Refund @relation(fields: [refund_id], references: [id], onDelete: Cascade)

  beneficiary_id BigInt
  store_id       BigInt
  mode           Mode

  amount_minor BigInt
  kind         AllocationKind @default(revenue)

  @@index([refund_id])
  @@index([beneficiary_id])
  @@map("refund_allocations")
}

/// جهة تُنسب لها الإيرادات. مش حساب أموال — التاجر هو Merchant of Record.
model Beneficiary {
  id BigInt @id @default(autoincrement())

  store_id BigInt
  mode     Mode

  kind         BeneficiaryKind
  external_ref String?         @db.VarChar(120)

  default_currency String @db.VarChar(3)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([store_id, mode, kind, external_ref])
  @@index([store_id, mode])
  @@map("beneficiaries")
}

/// حساب في الدفتر.
///
/// ⚠️ العملة جزء من هوية الحساب: دفتر بيخلط عملات في رصيد واحد
/// مابينفعش يتجمع، وأي استعلام رصيد بيرجّع كلام فاضي.
model LedgerAccount {
  id BigInt @id @default(autoincrement())

  store_id BigInt
  mode     Mode
  currency String @db.VarChar(3)

  account_type LedgerAccountType

  beneficiary_id     BigInt?
  payment_account_id BigInt?

  postings LedgerPosting[]

  created_at DateTime @default(now()) @db.Timestamptz(6)

  /// الاسم صريح: الاسم التلقائي بيطلع 89 حرف، وPostgres بيقصّه عند 63
  @@unique([store_id, mode, currency, account_type, beneficiary_id, payment_account_id], map: "ledger_accounts_identity_key")
  @@index([store_id, mode, currency])
  @@map("ledger_accounts")
}

/// قيد محاسبي. غير قابل للتعديل — التصحيح بقيد عكسي مش بتحديث.
/// ثابت: مجموع المدين = مجموع الدائن، داخل عملة واحدة.
model JournalEntry {
  id BigInt @id @default(autoincrement())

  store_id BigInt
  mode     Mode
  currency String @db.VarChar(3)

  /// نوع القاعدة اللي أنتجت القيد. نص مش enum: التصنيف مفتوح
  /// وبيكبر مع كل بوابة جديدة.
  entry_type String @db.VarChar(60)

  source_kind String @db.VarChar(40)
  source_id   String @db.VarChar(64)

  /// مشتق من المحتوى — بيخلي الترحيل idempotent مهما كان مصدر الحدث
  dedupe_key String @unique @db.VarChar(120)

  occurred_at DateTime @db.Timestamptz(6)
  posted_at   DateTime @default(now()) @db.Timestamptz(6)

  reverses_entry_id BigInt?

  memo String? @db.VarChar(400)

  postings LedgerPosting[]

  @@index([store_id, mode, currency, occurred_at])
  @@index([source_kind, source_id])
  @@map("journal_entries")
}

model LedgerPosting {
  id BigInt @id @default(autoincrement())

  entry_id BigInt
  entry    JournalEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  ledger_account_id BigInt
  ledgerAccount     LedgerAccount @relation(fields: [ledger_account_id], references: [id], onDelete: Restrict)

  direction PostingDirection

  /// دايماً موجب — الاتجاه في direction
  amount_minor BigInt

  @@index([entry_id])
  @@index([ledger_account_id])
  @@map("ledger_postings")
}

/// سجل ملحق غير قابل للتعديل لكل ما يحصل للنية.
/// للتدقيق وأدلة النزاعات — مش لإعادة بناء الحالة وقت التشغيل.
model PaymentEvent {
  id BigInt @id @default(autoincrement())

  intent_id BigInt
  intent    PaymentIntent @relation(fields: [intent_id], references: [id], onDelete: Cascade)

  store_id BigInt
  mode     Mode

  /// من التصنيف الموحّد للأحداث
  event_type String @db.VarChar(60)

  /// مشتق من المحتوى مش من وسيلة النقل — نفس الحقيقة من webhook أو
  /// مطابقة أو رجوع العميل بتدي نفس المفتاح
  dedupe_key String @unique @db.VarChar(120)

  source PaymentEventSource

  /// false معناه الحدث اتسجّل لكن ماغيّرش الحالة (قديم أو مكرر)
  applied           Boolean @default(true)
  superseded_reason String? @db.VarChar(120)

  payload_redacted Json?

  occurred_at DateTime? @db.Timestamptz(6)
  recorded_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([intent_id, recorded_at])
  @@index([store_id, mode, event_type])
  @@map("payment_events")
}